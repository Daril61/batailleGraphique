<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bataillenavale_graphique.LobbyController">
   <children>
      <Label alignment="CENTER" prefHeight="43.0" prefWidth="268.0" text="BATTLESHIP" textAlignment="CENTER">
         <font>
            <Font name="Arial Bold" size="38.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#SoloButton" prefHeight="26.0" prefWidth="100.0" text="Jouer" />
            <Button layoutX="280.0" layoutY="97.0" mnemonicParsing="false" onAction="#MultiplayerButton" prefHeight="26.0" prefWidth="100.0" text="Multijoueur" />
            <Button layoutX="277.0" layoutY="110.0" mnemonicParsing="false" onAction="#QuitButton" prefHeight="26.0" prefWidth="100.0" text="Quitter" />
         </children>
      </VBox>
   </children>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
</VBox>
